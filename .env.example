# ==============================================================================
# Dairy AI Assistant - Production Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

# Execution & Hardware Settings
# Set FORCE_CPU=true in container/cloud environments without CUDA GPU
FORCE_CPU=true
ENABLE_EXPERIMENTAL_MODELS=false

# Security & Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed web/mobile frontend origins
CORS_ORIGINS="http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000,https://dairy-nova-ai-gilt.vercel.app,https://dairy-nova-ai.vercel.app,capacitor://localhost,*"

# AI & LLM Provider Configuration
# Supported providers: "local" (deterministic built-in Indic engine), "gemini", "openai"
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL="gemini-3.5-flash"
TRANSLATION_API_KEY=""

# Chat & NLP Configuration
CHAT_DEFAULT_LANGUAGE="en"
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_HISTORY_MESSAGES=10

# Supabase Persistent Cloud Database Configuration
# Live project: https://mhyoovoguvmwnlkwqggd.supabase.co
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Fast2SMS OTP Authentication Configuration
# Obtain your API key from Fast2SMS Dev API Console (https://www.fast2sms.com/dashboard/dev-api)
FAST2SMS_API_KEY=""
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
